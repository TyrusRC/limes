COMPOSE_PROJECT_NAME=limes

# Plain HTTP is served on LIMES_HTTP_PORT, on this machine only. Set LIMES_BIND=0.0.0.0 to serve other hosts;
# the login then crosses the network in clear text, so add TLS (`make certs`, `make up HTTPS=1`, LIMES_HTTPS_PORT).
LIMES_BIND=127.0.0.1
LIMES_BIND6=::1
LIMES_HTTP_PORT=8082
LIMES_HTTPS_PORT=443

# Certificate authority (used by `make certs`)
AUTHORITY_NAME=Limes
AUTHORITY_PASSWORD=CHANGE_ME
COMPANY=Limes
DOMAIN_NAME=limes.example.com
COUNTRY_CODE=US
STATE=Georgia
CITY=Atlanta

# Database
POSTGRES_DB=limes
POSTGRES_USER=limes
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_HOST=db
PG_MAX_CONNECTIONS=100
DB_POOL_SIZE=40
# Pin a tested edoburu/pgbouncer tag; compose refuses to start while this is empty
PGBOUNCER_TAG=

# Django
LIMES_SECRET_KEY=CHANGE_ME
# Fernet key encrypting secret scan-identity headers at rest
LIMES_SECRET_KEY_ENCRYPTION=CHANGE_ME
DJANGO_SUPERUSER_USERNAME=limes
DJANGO_SUPERUSER_EMAIL=limes@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME

# Email channel of alert rules (docs/alerting.md). Leave the host empty and the channel reports 'not configured'.
# LIMES_EMAIL_HOST=smtp.example.com
# LIMES_EMAIL_PORT=587
# LIMES_EMAIL_USER=
# LIMES_EMAIL_PASSWORD=
# LIMES_EMAIL_USE_TLS=true
# LIMES_EMAIL_FROM=limes@example.com
# Alert-rule sends per project and channel per hour; the overflow is counted and reported once per window
# LIMES_ALERT_RULE_IN_APP_PER_HOUR=60
# LIMES_ALERT_RULE_EMAIL_PER_HOUR=30
# LIMES_ALERT_RULE_SLACK_PER_HOUR=60
# LIMES_ALERT_RULE_WEBHOOK_PER_HOUR=120
# LIMES_ALERT_RULE_JIRA_PER_HOUR=20

# Owned ranges and ASNs (limes/owned_ranges.py). The commented values are the defaults.
# Walk owned ranges and ASN prefixes per IP with PTR and Shodan InternetDB. Off by default: InternetDB is free for
# non-commercial use only, and commercial use needs a Shodan enterprise license.
# LIMES_RANGE_ENUMERATION=false
# Addresses one project may hold as ranges and ASN prefixes (hard maximum 65536)
# LIMES_RANGE_ADDRESS_CAP=4096
# Calls per day for this instance, spread over the 60 s ticks
# LIMES_INTERNETDB_DAILY_BUDGET=5000
# LIMES_PTR_DAILY_BUDGET=10000

# MCP server write tools (all off by default; a token must also be read_write and the user's role must allow the action)
# LIMES_MCP_WRITES_ENABLED=false
# Tier of assets an agent adds with add_assets: candidate (a human confirms them), owned_host or owned_root
# WARNING: anything above candidate makes agent-added assets ACTIVE scan targets at once; a prompt injection could
# enroll a third-party domain. Keep candidate unless you accept that.
# LIMES_MCP_ADD_TIER=candidate

# Reputation feeds (limes/feeds)
# blocklist_de,cins: terms unclear, off by default
# LIMES_FEEDS_OPTIN=
# Sent only to abuse.ch hosts (Feodo works without it)
LIMES_ABUSECH_AUTH_KEY=
# Spamhaus DQS key for per-IP ZEN lookups (empty: off); never logged
LIMES_SPAMHAUS_DQS_KEY=
# Have I Been Pwned API key (domain breach counts for owned roots; empty = off); never logged
LIMES_HIBP_API_KEY=

# Lookalike domains of owned roots (DNS, RDAP and crt.sh only)
LIMES_LOOKALIKE_ENABLED=true
LIMES_LOOKALIKE_DNS_DAILY_BUDGET=5000
LIMES_RDAP_DAILY_BUDGET=500
# One HTTPS GET per registered lookalike per week; tells its operator someone is looking
LIMES_LOOKALIKE_HTTP=false

# Near-real-time monitoring (docs/realtime.md). The commented values are the defaults.
# Certificate watch: self-hosted certspotter, opt-in, needs `make up REALTIME=1` too. It reads every CT log:
# about 157 GB/day inbound, inferred, not measured. Measuring it needs the owner's go-ahead (docs/realtime-ct-watch.md).
# LIMES_CT_WATCH=false
# Seconds before a silent watcher is degraded
# LIMES_CT_WATCH_STALE=180
# Seconds between watchlist-driven certspotter restarts
# LIMES_CT_WATCH_RESTART_MIN=300
# Names on the watchlist (owned names win)
# LIMES_CT_WATCHLIST_MAX=5000
# Spool files ingested per minute
# LIMES_CT_INGEST_PER_MIN=600
# Where the watcher keeps certspotter state, spool and watchlist (the ct_state volume)
# LIMES_CT_STATE_DIR=/var/lib/ct-watch
# Minutes a watch that never came up waits before its one degraded alert
# LIMES_CT_DEGRADED_GRACE_MIN=15
# Seconds one cert_new digest row coalesces over
# LIMES_CT_EVENT_WINDOW=3600
# Owned hostnames certificates may add per project per hour
# LIMES_CT_NEW_HOSTS_PER_HOUR=200
# Cert Spotter API fallback, off without a key. The free plan allows 10 full-domain queries per hour and Limes uses 7.
# Unauthenticated use is "personal or evaluation" only: check SSLMate's terms. SSLMate sees your owned roots when set.
# LIMES_CERTSPOTTER_API_KEY=
# LIMES_CERTSPOTTER_HOURLY_BUDGET=7
# Event-driven checks (local only, no new third party)
# LIMES_EVENT_CHECKS=true
# LIMES_EVENT_QUEUE_MAX=1000
# Seconds between event checks of one asset
# LIMES_EVENT_COOLDOWN=900
# Event checks per project per hour
# LIMES_EVENT_BURST=200
# Share of each monitor tick the queue may use (0.1 to 0.9)
# LIMES_EVENT_SHARE=0.5
# Crown-jewel DNS watch: seconds between re-resolves (0 = off), and names per tick
# LIMES_DNS_WATCH_INTERVAL=900
# LIMES_DNS_WATCH_PER_TICK=30
# Overview refresh in seconds (0 = off)
# LIMES_LIVE_POLL_SECONDS=30

# Sizing (gen_env.py fills these from the host; leave empty to auto-size inside containers)
REDIS_MAXMEMORY=512mb
WORKER_SCAN_MEM=8g
WORKER_IO_MEM=2g
WORKER_ORCH_MEM=1g
WEB_MEM=2g
SCAN_SLOTS=
IO_CONCURRENCY=
WEB_WORKERS=
