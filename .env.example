COMPOSE_PROJECT_NAME=limes

# Certificate authority (used by `make certs`)
AUTHORITY_NAME=Limes
AUTHORITY_PASSWORD=CHANGE_ME
COMPANY=Limes
DOMAIN_NAME=limes.example.com
COUNTRY_CODE=US
STATE=Georgia
CITY=Atlanta

# Database
POSTGRES_DB=limes
POSTGRES_USER=limes
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_HOST=db
PG_MAX_CONNECTIONS=100
DB_POOL_SIZE=40
# Pin a tested edoburu/pgbouncer tag; compose refuses to start while this is empty
PGBOUNCER_TAG=

# Django
LIMES_SECRET_KEY=CHANGE_ME
# Fernet key encrypting secret scan-identity headers at rest
LIMES_SECRET_KEY_ENCRYPTION=CHANGE_ME
DJANGO_SUPERUSER_USERNAME=limes
DJANGO_SUPERUSER_EMAIL=limes@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME

# Owned ranges and ASNs (limes/owned_ranges.py). The commented values are the defaults.
# Walk owned ranges and ASN prefixes per IP with PTR and Shodan InternetDB. Off by default: InternetDB is free for
# non-commercial use only, and commercial use needs a Shodan enterprise license.
# LIMES_RANGE_ENUMERATION=false
# Addresses one project may hold as ranges and ASN prefixes (hard maximum 65536)
# LIMES_RANGE_ADDRESS_CAP=4096
# Calls per day for this instance, spread over the 60 s ticks
# LIMES_INTERNETDB_DAILY_BUDGET=5000
# LIMES_PTR_DAILY_BUDGET=10000

# Reputation feeds (limes/feeds)
# blocklist_de,cins: terms unclear, off by default
# LIMES_FEEDS_OPTIN=
# Sent only to abuse.ch hosts (Feodo works without it)
LIMES_ABUSECH_AUTH_KEY=
# Spamhaus DQS key for per-IP ZEN lookups (empty: off); never logged
LIMES_SPAMHAUS_DQS_KEY=
# Have I Been Pwned API key (domain breach counts for owned roots; empty = off); never logged
LIMES_HIBP_API_KEY=

# Sizing (gen_env.py fills these from the host; leave empty to auto-size inside containers)
REDIS_MAXMEMORY=512mb
WORKER_SCAN_MEM=8g
WORKER_IO_MEM=2g
WORKER_ORCH_MEM=1g
WEB_MEM=2g
SCAN_SLOTS=
IO_CONCURRENCY=
WEB_WORKERS=
